# MHCOIN pool operator env — copy to ~/.mhcoin/pool.env and chmod 600
#   cp packaging/pool/pool.env.example ~/.mhcoin/pool.env
# Never commit a real pool.env (passwords / addresses with funds).

MHCOIN_NETWORK=mainnet

# Dedicated chain + wallet for the pool node (NOT Desktop solo datadir).
MHCOIN_POOL_DATA=~/.mhcoin/pool-node
# SQLite ledger (rounds / credits / payouts).
MHCOIN_POOL_DIR=~/.mhcoin/pool

# Required: coinbase + fee address (from `mhcoin wallet create` in POOL_DATA).
MHCOIN_POOL_ADDRESS=mhc1YOUR_POOL_ADDRESS

# Required for auto-payouts (wallet password for POOL_DATA).
MHCOIN_POOL_PASSWORD=change-me

# Listen ports (open in firewall / NAT as needed).
MHCOIN_POOL_PORT=3333
MHCOIN_POOL_STRATUM_PORT=3334
MHCOIN_POOL_WEB_PORT=8888
# MHCOIN_POOL_LISTEN=0.0.0.0
# MHCOIN_POOL_WEB_HOST=0.0.0.0

# Economics
MHCOIN_POOL_FEE_PERCENT=1
MHCOIN_POOL_SHARE_FACTOR=1024
# Confirmations before immature credits mature.
MHCOIN_POOL_MATURE_CONFIRMS=20
# Auto-payout threshold in sats (default 0.1 MHC = 10000000). 0 = disable auto-payout.
MHCOIN_POOL_PAYOUT_THRESHOLD=10000000

# P2P bootstrap for the embedded pool-node (comma-separated host:port).
# Include at least one reachable mainnet seed / peer.
MHCOIN_CONNECT=176.38.3.168:8333
# Optional preferred LAN seed when co-located with a local node:
# MHCOIN_LOCAL_SEED=127.0.0.1:8333

# Optional: public stats URL shown to miners / explorer nav.
# MHCOIN_POOL_URL=http://YOUR_PUBLIC_HOST:8888
# MHCOIN_EXPLORER_URL=http://YOUR_EXPLORER_HOST:8766
